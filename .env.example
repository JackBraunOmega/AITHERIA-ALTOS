# AITHERIA ALTOS - Environment Configuration
# ==========================================
# This file contains all environment variables used by the AITHERIA ALTOS platform.
# Copy this file to .env and modify the values as needed.
# IMPORTANT: Never commit the actual .env file to version control!

# ----------------------
# Environment Settings
# ----------------------
# Possible values: development, staging, production, test
ENVIRONMENT=development

# ----------------------
# Database Configuration
# ----------------------
# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aitheria_auth
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database connection string (used by application)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aitheria_auth

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ----------------------
# Redis Configuration
# ----------------------
REDIS_PASSWORD=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Full Redis connection string (used by application)
# Format: redis://[:password@]host[:port][/db-number]
REDIS_URL=redis://:redis@redis:6379/0
REDIS_POOL_SIZE=10

# ----------------------
# JWT Authentication
# ----------------------
# Secret key for signing JWT tokens (generate a strong random key in production!)
JWT_SECRET_KEY=super_secret_key_change_in_production

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------
# API Configuration
# ----------------------
# API version prefix
API_V1_STR=/api/v1

# Server host (for generating URLs)
SERVER_HOST=http://localhost:8080

# Frontend URL (for redirects and CORS)
FRONTEND_URL=http://localhost:3000

# ----------------------
# CORS Configuration
# ----------------------
# Comma-separated list of origins that can access the API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ----------------------
# Initial Superuser
# ----------------------
# Initial admin user credentials (created on first startup)
FIRST_SUPERUSER=admin@aitheria-altos.com
FIRST_SUPERUSER_PASSWORD=Admin123!

# ----------------------
# Security Settings
# ----------------------
# Password hashing rounds (higher is more secure but slower)
BCRYPT_ROUNDS=12

# Account lockout settings
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Session cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
USE_REFRESH_TOKEN_COOKIE=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_PERIOD=60

# API token settings
API_TOKEN_DEFAULT_EXPIRY_DAYS=90

# ----------------------
# Feature Flags
# ----------------------
ENABLE_MFA=false
ENABLE_SSO=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_AUDIT_LOG=true

# ----------------------
# OAuth Providers
# ----------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ORCID OAuth
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ----------------------
# Logging Configuration
# ----------------------
LOG_LEVEL=INFO
LOG_FORMAT=simple

# ----------------------
# Docker Compose Settings
# ----------------------
# Ports for services
AUTH_SERVICE_PORT=8001
API_GATEWAY_PORT=8080
